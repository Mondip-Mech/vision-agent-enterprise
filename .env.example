# ──────────────────────────────────────────────────────────────────────────────
# Voxly — Environment Variables
# Copy this file to .env and fill in your values.
# .env is listed in .gitignore and should NEVER be committed.
# ──────────────────────────────────────────────────────────────────────────────

# ── Provider selection ────────────────────────────────────────────────────────
# Choose one AI backend.  Default: nvidia
# Valid values: nvidia | openai | anthropic

# CAPTION_PROVIDER=nvidia

# ── NVIDIA NIM (default provider) ────────────────────────────────────────────
# Free key at https://build.nvidia.com/ → select a vision model → "Get API Key"

NVIDIA_API_KEY=nvapi-your-key-here

# ── OpenAI (set CAPTION_PROVIDER=openai to use) ───────────────────────────────
# https://platform.openai.com/api-keys

# OPENAI_API_KEY=sk-your-openai-key-here
# OPENAI_MODEL=gpt-4o

# ── Anthropic (set CAPTION_PROVIDER=anthropic to use) ─────────────────────────
# https://console.anthropic.com/settings/keys

# ANTHROPIC_API_KEY=sk-ant-your-key-here
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ── Optional — override only if you need non-default values ───────────────────

# NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_VISION_MODEL=nvidia/llama-3.1-nemotron-nano-vl-8b-v1
# NVIDIA_MAX_IMAGE_BYTES=184320
# REQUEST_TIMEOUT_SECONDS=60
