# ──────────────────────────────────────────────────────────────────────────────
# Voxly — Environment Variables
# Copy this file to .env and fill in your values.
# .env is listed in .gitignore and should NEVER be committed.
# ──────────────────────────────────────────────────────────────────────────────

# ── Required ──────────────────────────────────────────────────────────────────

# NVIDIA NIM API key — get one free at https://build.nvidia.com/
# Select any vision model → "Get API Key"
NVIDIA_API_KEY=nvapi-your-key-here

# ── Optional — override only if you need non-default values ───────────────────

# NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_VISION_MODEL=nvidia/llama-3.1-nemotron-nano-vl-8b-v1
# NVIDIA_MAX_IMAGE_BYTES=184320
# REQUEST_TIMEOUT_SECONDS=60
